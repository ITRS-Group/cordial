<?xml version="1.0" encoding="ISO-8859-1"?>
<gateway compatibility="1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://schema.itrsgroup.com/GA7.4.2-250625/gateway.xsd">
	<types>
		<typeGroup name="Geneos">
			<type name="Gateway Host">
				<samplerInclude ref="Gateway Process"/>
				<samplerInclude ref="Gateway Log"/>
			</type>
			<type name="Licd Host">
				<samplerInclude ref="Licd Process"/>
				<samplerInclude ref="Licd Log"/>
			</type>
		</typeGroup>
	</types>
	<samplers>
		<samplerGroup name="Geneos">
			<sampler name="Geneos Processes">
				<var-group>
					<data>Geneos</data>
				</var-group>
				<plugin>
					<processes>
						<adjustForLogicalCPUs>
							<data>false</data>
						</adjustForLogicalCPUs>
						<adjustForLogicalCPUsSummary>
							<data>false</data>
						</adjustForLogicalCPUsSummary>
					</processes>
				</plugin>
			</sampler>
			<sampler name="Geneos Logs">
				<var-group>
					<data>Geneos</data>
				</var-group>
				<plugin>
					<fkm>
						<display>
							<columns>
								<column>status</column>
								<column>triggerCount</column>
								<column>triggerDetails</column>
								<column>filename</column>
								<column>fileSize</column>
								<column>lastModificationTime</column>
								<column>updateRate</column>
							</columns>
							<triggerMode>MULTIPLE</triggerMode>
							<lastTriggerInStatus>
								<data>false</data>
							</lastTriggerInStatus>
						</display>
						<wildcardMonitorAllMatches>
							<data>true</data>
						</wildcardMonitorAllMatches>
					</fkm>
				</plugin>
			</sampler>
		</samplerGroup>
	</samplers>
	<samplerIncludes>
		<samplerIncludeGroup name="Geneos">
			<samplerInclude name="Gateway Process">
				<sampler ref="Geneos Processes"/>
				<plugin>
					<processes>
						<processes>
							<process>
								<processDescriptor ref="Gateway"/>
							</process>
						</processes>
					</processes>
				</plugin>
			</samplerInclude>
			<samplerInclude name="Licd Process">
				<sampler ref="Geneos Processes"/>
				<plugin>
					<processes>
						<processes>
							<process>
								<processDescriptor ref="LICD"/>
							</process>
						</processes>
					</processes>
				</plugin>
			</samplerInclude>
			<samplerInclude name="Netprobe Process">
				<sampler ref="Geneos Processes"/>
				<plugin>
					<processes>
						<processes>
							<process>
								<processDescriptor ref="Netprobe"/>
							</process>
						</processes>
					</processes>
				</plugin>
			</samplerInclude>
			<samplerInclude name="Gateway Log">
				<sampler ref="Geneos Logs"/>
				<plugin>
					<fkm>
						<files>
							<file>
								<source>
									<processDescriptor ref="Gateway"/>
								</source>
								<alias>
									<data>Gateway</data>
								</alias>
							</file>
						</files>
					</fkm>
				</plugin>
			</samplerInclude>
			<samplerInclude name="Netprobe Log">
				<sampler ref="Geneos Logs"/>
				<plugin>
					<fkm>
						<files>
							<file>
								<source>
									<processDescriptor ref="Netprobe"/>
								</source>
								<alias>
									<data>Netprobe</data>
								</alias>
							</file>
						</files>
					</fkm>
				</plugin>
			</samplerInclude>
			<samplerInclude name="Licd Log">
				<sampler ref="Geneos Logs"/>
				<plugin>
					<fkm>
						<files>
							<file>
								<source>
									<processDescriptor ref="LICD"/>
								</source>
								<alias>
									<data>License Daemon</data>
								</alias>
							</file>
						</files>
					</fkm>
				</plugin>
			</samplerInclude>
		</samplerIncludeGroup>
	</samplerIncludes>
	<rules>
		<ruleGroup name="Geneos">
			<ruleGroup name="Process">
				<default name="GLOBAL Process Default">
					<rule>
						<priorityGroup>10000</priorityGroup>
					</rule>
				</default>
				<rule name="Instance Count 1">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;PROCESSES&quot;)]/dataview/rows/row[not(contains(@name,&quot;#&quot;))]/cell[(@column=&quot;instanceCount&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<lt>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<integer>1</integer>
							</lt>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>critical</severity>
								</update>
							</transaction>
							<if>
								<gt>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<integer>1</integer>
								</gt>
								<transaction>
									<delay unit="samples">1</delay>
									<update>
										<property>state/@severity</property>
										<severity>warning</severity>
									</update>
								</transaction>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>ok</severity>
									</update>
								</transaction>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="FKM">
				<rule name="FKM">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@name=&quot;Logfiles&quot;)]/dataview[(@name=&quot;Logfiles&quot;)]/rows/row/cell[(@column=&quot;status&quot;)]</target>
					</targets>
					<priority>5</priority>
					<block>
						<if>
							<like>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>OK</string>
							</like>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>ok</severity>
								</update>
							</transaction>
							<if>
								<like>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<string>NOT_FOUND*</string>
								</like>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>warning</severity>
									</update>
								</transaction>
								<if>
									<like>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<string/>
									</like>
									<if>
										<like>
											<target>
												<rowName/>
											</target>
											<string>*fail*</string>
										</like>
										<transaction>
											<update>
												<property>state/@severity</property>
												<severity>critical</severity>
											</update>
										</transaction>
										<if>
											<like>
												<target>
													<rowName/>
												</target>
												<string>*warning*</string>
											</like>
											<transaction>
												<update>
													<property>state/@severity</property>
													<severity>warning</severity>
												</update>
											</transaction>
										</if>
									</if>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>undefined</severity>
										</update>
									</transaction>
								</if>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
		</ruleGroup>
	</rules>
	<staticVars>
		<processDescriptors>
			<processDescriptorGroup name="Application">
				<processDescriptor name="Netprobe">
					<alias>
						<data>Netprobe</data>
					</alias>
					<ID>
						<searchString>
							<data>.*netprobe.*</data>
							<var ref="netprobePort"/>
						</searchString>
						<rules>basic/regex</rules>
					</ID>
					<logFile>
						<data>netprobe.log</data>
					</logFile>
				</processDescriptor>
				<processDescriptor name="Gateway">
					<alias>
						<data>Gateway</data>
					</alias>
					<ID>
						<searchString>
							<data>.*gateway2.*</data>
							<var ref="_gatewayInstance"/>
						</searchString>
					</ID>
					<logFile>
						<var ref="_gatewayLogFile"/>
					</logFile>
				</processDescriptor>
				<processDescriptor name="LICD">
					<alias>
						<data>License Daemon</data>
					</alias>
					<ID>
						<searchString>
							<data>.*licd.linux.*</data>
						</searchString>
					</ID>
					<stop>
						<data/>
					</stop>
					<logFile>
						<var ref="_geneosHome"/>
						<data>/licd/licds/perm/licd.log</data>
					</logFile>
				</processDescriptor>
			</processDescriptorGroup>
		</processDescriptors>
	</staticVars>
</gateway>