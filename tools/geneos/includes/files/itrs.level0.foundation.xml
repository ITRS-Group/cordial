									</tableName>
									<xpath>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-managedEntitiesData&quot;)]/dataview[(@name=&quot;Entities Details&quot;)]</xpath>
								</dataview>
							</tables>
							<sampleSql>
								<sql>
									<data>DELETE FROM attributes;
DELETE FROM MES;
INSERT INTO attributes
    WITH split (word, str, hascomma) AS (
        SELECT &apos;&apos;,
            attributes,
            1
        FROM AllME
        UNION ALL
        SELECT SUBSTR(
                str,
                0,
                CASE
                    WHEN INSTR(str, &apos;,&apos;) THEN INSTR(str, &apos;,&apos;)
                    ELSE LENGTH(str) + 1
                END
            ),
            LTRIM(SUBSTR(str, INSTR(str, &apos;,&apos;)), &apos;,&apos;),
            INSTR(str, &apos;,&apos;)
        FROM split
        WHERE hascomma
    )
SELECT DISTINCT SUBSTR(TRIM(word), 0, INSTR(TRIM(word), &apos;=&apos;))
FROM split
WHERE word != &apos;&apos;;

INSERT INTO MES
SELECT *
FROM (
        SELECT ME.name AS name,
            A.name AS attributes,
            INSTR(ME.attributes, A.name) AS value
        FROM AllME ME,
            attributes A
    );</data>
								</sql>
							</sampleSql>
