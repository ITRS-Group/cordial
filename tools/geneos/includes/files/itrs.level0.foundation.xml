											<property>state/@severity</property>
											<severity>warning</severity>
										</update>
									</transaction>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>ok</severity>
										</update>
									</transaction>
								</if>
							</if>
						</if>
					</block>
				</rule>
				<rule name="managedEntityCount">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler/dataview/rows/row/cell[(@column=&quot;managedEntityCount&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<equal>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>0</string>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>warning</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Database">
				<rule name="cacheFiles">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-databaseLogging&quot;)]/dataview[(@name=&quot;Cache&quot;)]/rows/row[(@name=&quot;cacheFiles&quot;)]/cell[(@column=&quot;value&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<gt>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<integer>0</integer>
							</gt>
							<transaction>
								<delay>60</delay>
								<update>
									<property>state/@severity</property>
									<severity>critical</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>ok</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Obcerv - Analytics">
				<rule name="connectionStatus">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-obcervConnection&quot;)]/dataview[(@name=&quot;Summary&quot;)]/rows/row[(@name=&quot;connectionStatus&quot;)]/cell[(@column=&quot;value&quot;)]</target>
					</targets>
					<priority>1</priority>
					<pathAliases>
						<pathAlias name="enabled">../../row[(@name=&quot;enabled&quot;)]/cell[(@column=&quot;value&quot;)]</pathAlias>
					</pathAliases>
					<block>
						<if>
							<equal>
								<dataItem>
									<pathAlias ref="enabled"/>
									<property>@value</property>
								</dataItem>
								<string>false</string>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
							<if>
								<notEqual>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<string>Ready</string>
								</notEqual>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>critical</severity>
									</update>
								</transaction>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>ok</severity>
									</update>
								</transaction>
							</if>
						</if>
					</block>
				</rule>
				<rule name="messagesDroppedPerSample">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-obcervConnection&quot;)]/dataview[(@name=&quot;Summary&quot;)]/rows/row[(@name=&quot;messagesDroppedPerSample&quot;)]/cell[(@column=&quot;value&quot;)]</target>
					</targets>
					<priority>1</priority>
					<pathAliases>
						<pathAlias name="enabled">../../row[(@name=&quot;enabled&quot;)]/cell[(@column=&quot;value&quot;)]</pathAlias>
					</pathAliases>
					<block>
						<if>
							<gt>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<integer>0</integer>
							</gt>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>warning</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>ok</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Licence">
				<rule name="connected">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-licenceUsage&quot;)]/dataview/rows/row[(@name=&quot;connected&quot;)]/cell[(@column=&quot;Value&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<equal>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string/>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
							<if>
								<notEqual>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<string>YES</string>
								</notEqual>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>critical</severity>
									</update>
								</transaction>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>ok</severity>
									</update>
								</transaction>
							</if>
						</if>
					</block>
				</rule>
				<rule name="licenceDaysRemaining">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-licenceUsage&quot;)]/dataview/rows/row[(@name=&quot;licenseDaysRemaining&quot;)]/cell[(@column=&quot;Value&quot;)]</target>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[wild(@name,&quot;Global *&quot;)]/dataview[(@name=&quot;GW Components&quot;)]/rows/row/cell[(@column=&quot;licenseDaysRemaining&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<equal>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string/>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
							<if>
								<lt>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<integer>5</integer>
								</lt>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>critical</severity>
									</update>
								</transaction>
								<if>
									<lt>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<integer>15</integer>
									</lt>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>warning</severity>
										</update>
									</transaction>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>ok</severity>
										</update>
									</transaction>
								</if>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Import Export">
				<rule name="connectionStatus">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-importedData&quot;)]/dataview/rows/row/cell[(@column=&quot;connectionStatus&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<notEqual>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>Up</string>
							</notEqual>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>critical</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>ok</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
				<rule name="conflictingProbes">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;Gateway-importedData&quot;)]/dataview/rows/row/cell[(@column=&quot;conflictingProbes&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<notEqual>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string/>
							</notEqual>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>warning</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Entities">
				<rule name="priority">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler/dataview[(@name=&quot;Entities Details&quot;)]/rows/row/cell[(@column=&quot;priority&quot;)]</target>
					</targets>
					<priority>1</priority>
					<pathAliases>
						<pathAlias name="att">../cell[(@column=&quot;attributes&quot;)]</pathAlias>
					</pathAliases>
					<block>
						<if>
							<like>
								<dataItem>
									<pathAlias ref="att"/>
									<property>@value</property>
								</dataItem>
								<string>*PRIORITY*</string>
							</like>
							<transaction>
								<update>
									<property>@value</property>
									<stringBefore>
										<stringAfter>
											<dataItem>
												<pathAlias ref="att"/>
												<property>@value</property>
											</dataItem>
											<string>PRIORITY=</string>
										</stringAfter>
										<string>,</string>
									</stringBefore>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>@value</property>
									<string/>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
		</ruleGroup>
		<ruleGroup name="Sampling Status">
			<rule name="Sampling Status">
				<targets>
					<target>/geneos/gateway/directory/probe/managedEntity/sampler/dataview/headlines/cell[(@name=&quot;samplingStatus&quot;)]</target>
				</targets>
				<priority>1</priority>
				<block>
					<if>
						<or>
							<like>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>OK</string>
							</like>
							<like>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>NOTE: Stats collection is disabled</string>
							</like>
						</or>
						<transaction>
							<update>
								<property>state/@severity</property>
								<severity>undefined</severity>
							</update>
						</transaction>
						<transaction>
							<update>
								<property>state/@severity</property>
								<severity>warning</severity>
							</update>
						</transaction>
					</if>
				</block>
			</rule>
		</ruleGroup>
	</rules>
	<persistence><!--Persistence is enabled by default for all history periods. If the default timings
are not suitable, override in a higher priority include file or main setup file.--></persistence>
	<selfAnnouncingProbes>
		<enabled>true</enabled>
		<disconnectedProbeTimeout>3600</disconnectedProbeTimeout>
	</selfAnnouncingProbes>
	<exportedData/>
	<operatingEnvironment>
		<selfMonitoring>
			<gatewaySamplerOverride>
				<what>Entities</what>
				<how>
					<sampler ref="Entities"/>
				</how>
			</gatewaySamplerOverride>
			<gatewaySamplerOverride>
				<what>Custom</what>
				<how>
					<sampler ref="Licence"/>
				</how>
			</gatewaySamplerOverride>
			<gatewaySamplerOverride>
				<what>Severity Count</what>
				<how>
					<sampler ref="Severity Count"/>
				</how>
			</gatewaySamplerOverride>
			<gatewaySamplerOverride>
				<what>Custom</what>
				<how>
					<sampler ref="Severity Data"/>
				</how>
			</gatewaySamplerOverride>
		</selfMonitoring>
		<writeStatsToFile>
			<filename>stats.xml</filename>
			<enablePeriodicWrite>true</enablePeriodicWrite>
			<writeInterval>50</writeInterval>
		</writeStatsToFile>
	</operatingEnvironment>
</gateway>