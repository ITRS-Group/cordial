<?xml version="1.0" encoding="ISO-8859-1"?>
<netprobe>
	<selfAnnounce>
		<enabled>true</enabled>
		<retryInterval>60</retryInterval>
		<requireReverseConnection>true</requireReverseConnection>
		<probeName>{{ .sanname }}</probeName>
		<managedEntities>
			{{- if .types }}
			<managedEntity>
				<name>{{ .sanname }}</name>
				{{ if .attributes -}}
				<attributes>
					{{ range $key, $value := .attributes -}}
					<attribute name="{{ nameOf $value "=" }}">{{ valueOf $value "=" }}</attribute>
					{{ end }}
				</attributes>
				{{- end}}
				<variables>
					<!-- variables prefixed with '_' are added automatically -->
					<var name="_netprobeInstance">
						<string>{{ .name }}</string>
					</var>
					<var name="_geneosHome">
						<string>{{ .root }}</string>
					</var>
					<var name="_netprobeHome">
						<string>{{ .home }}</string>
					</var>
					<var name="_netprobeBaseVersion">
						<string>{{ .version }}</string>
					</var>
					<var name="_netprobeLogFile">
						<string>{{ join .home .logfile }}</string>
					</var>
					{{- if .variables }}
					{{- range .variables }}
					<var name="{{ .name }}">
						<{{ .type }}>{{ .value }}</{{ .type }}>
					</var>{{- end }}
					{{- end }}
				</variables>
				{{- if .types }}
				<types>
					{{- range .types }}
					<type>{{ . }}</type>
					{{- end }}
				</types>
				{{- end }}
			</managedEntity>
			{{- end -}}
			{{- range .entities }}
			{{- if .types }}
			<managedEntity>
				<name>{{ .name}}</name>
				{{if .attributes -}}<attributes>
					{{ range $key, $value := .attributes -}}
					<attribute name="{{ nameOf $value "=" }}">{{ valueOf $value "=" }}</attribute>
					{{- end }}
				</attributes>
				{{- end -}}
				{{- if .variables -}}
				<variables>
					{{- range .variables }}
					<var name="{{ .name }}">
						<{{ .type }}>{{ .value }}</{{ .type }}>
					</var>{{ end }}
				</variables>
				{{- end -}}
				{{- if .types }}
				<types>
					{{- range .types }}
					<type>{{ . }}</type>{{ end }}
				</types>
				{{- end }}
			</managedEntity>
			{{- end }}
			{{- end }}
		</managedEntities>
		<gateways>
			{{- with $data := . -}}
			{{- $secure := or $data.certchain (and $data.tls (or $data.tls.secure (index $data.tls "ca-bundle") $data.tls.verify)) }}
			{{- range $key, $value := $data.gateways }}
			<gateway>
				<hostname>{{$key}}</hostname>
				<port>{{$value}}</port>
				<secure>{{if $secure}}true{{else}}false{{end}}</secure>
			</gateway>
			{{- else }}
			<gateway>
				<hostname>localhost</hostname>
				<port>{{ if $secure }}7038{{ else }}7039{{ end }}</port>
				<secure>{{ if $secure }}true{{ else }}false{{ end }}</secure>
			</gateway>
			{{- end }}
			{{- end }}
		</gateways>
	</selfAnnounce>
</netprobe>
