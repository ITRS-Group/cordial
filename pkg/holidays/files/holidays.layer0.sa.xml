					<scheduledPeriod><date>04/06/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>07/09/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>12/10/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>02/11/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>20/11/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>24/12/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>25/12/2026</date><override>true</override></scheduledPeriod>
					<scheduledPeriod><date>31/12/2026</date><override>true</override></scheduledPeriod>
					<timezone><America>Sao_Paulo</America></timezone>
				</activeTime>
			</activeTimeGroup>
		</activeTimeGroup>
	</activeTimes>
</gateway>
