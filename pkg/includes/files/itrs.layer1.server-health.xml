	<rules>
		<ruleGroup name="Layer 1 - Server Health">
			<ruleGroup name="CPU">
				<rule name="averageCPUUtilisation">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 1 - Server Health&quot;)][(param(&quot;PluginName&quot;)=&quot;CPU&quot;)]/dataview/rows/row[(@name=&quot;Average_cpu&quot;)]/cell[(@column=&quot;percentUtilisation&quot;)]</target>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 1 - Server Health&quot;)][(param(&quot;PluginName&quot;)=&quot;CPU&quot;)]/dataview/rows/row[(@name=&quot;_Total&quot;)]/cell[(@column=&quot;%processorTime&quot;)]</target>
					</targets>
					<priority>1005</priority>
					<block>
						<if>
							<gt>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<integer>95</integer>
							</gt>
							<transaction>
								<delay unit="samples">12</delay>
								<update>
									<property>state/@severity</property>
									<severity>critical</severity>
								</update>
							</transaction>
							<if>
								<and>
									<gt>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<integer>80</integer>
									</gt>
									<gte>
										<rate>
											<dataItem>
												<property>@value</property>
											</dataItem>
										</rate>
										<integer>0</integer>
									</gte>
								</and>
								<block>
									<transaction>
										<delay unit="samples">12</delay>
									</transaction>
									<if>
										<equal>
											<dataItem>
												<property>state/@severity</property>
											</dataItem>
											<severity>warning</severity>
										</equal>
										<transaction>
											<delay unit="samples">12</delay>
											<update>
												<property>state/@severity</property>
												<severity>critical</severity>
											</update>
										</transaction>
										<if>
											<notEqual>
												<dataItem>
													<property>state/@severity</property>
												</dataItem>
												<severity>critical</severity>
											</notEqual>
											<transaction>
												<update>
													<property>state/@severity</property>
													<severity>warning</severity>
												</update>
											</transaction>
										</if>
									</if>
								</block>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>ok</severity>
									</update>
								</transaction>
							</if>
						</if>
					</block>
				</rule>
				<rule name="stuckCPUCore">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 1 - Server Health&quot;)][(param(&quot;PluginName&quot;)=&quot;CPU&quot;)]/dataview/rows/row[contains(@name,&quot;#&quot;)]/cell[(@column=&quot;percentUtilisation&quot;)]</target>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 1 - Server Health&quot;)][(param(&quot;PluginName&quot;)=&quot;CPU&quot;)]/dataview/rows/row[contains(@name,&quot;#&quot;)]/cell[(@column=&quot;%processorTime&quot;)]</target>
					</targets>
					<priority>1005</priority>
					<block>
						<if>
							<gt>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<integer>99</integer>
							</gt>
							<block>
								<transaction>
									<delay unit="samples">12</delay>
								</transaction>
								<if>
									<and>
										<equal>
											<dataItem>
												<property>state/@severity</property>
											</dataItem>
											<severity>warning</severity>
										</equal>
										<gte>
											<rate>
												<dataItem>
													<property>@value</property>
												</dataItem>
											</rate>
											<integer>0</integer>
