								</update>
							</transaction>
						</if>
					</block>
				</rule>
				<rule name="hyperThreading">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;CPU&quot;)]/dataview[(@name=&quot;CPU&quot;)]/headlines/cell[(@name=&quot;HyperThreadingStatus&quot;)]</target>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;HARDWARE&quot;)]/dataview[(@name=&quot;Hardware&quot;)]/rows/row[(@name=&quot;hyperThreadingStatus&quot;)]/cell[(@column=&quot;Value&quot;)]</target>
					</targets>
					<priority>1</priority>
					<block>
						<if>
							<and>
								<equal>
									<var ref="hyperThreadingOK"/>
									<boolean>false</boolean>
								</equal>
								<equal>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<string>ENABLED</string>
								</equal>
							</and>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>warning</severity>
								</update>
							</transaction>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Disk">
				<rule name="percentagUsed">
					<!--Ignore rows where the freeSpace and totalSpace columns are 0, which are
typically pseudo-devices.

If the usage is greater than 95% or greater than 90% and the rate of change is
greater than 1% per hour, then warning. If condition continues for an hour,
critical.-->
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 1 - Server Health&quot;)][(param(&quot;PluginName&quot;)=&quot;DISK&quot;)]/dataview/rows/row/cell[(@column=&quot;percentageUsed&quot;)]</target>
					</targets>
					<priority>1005</priority>
					<pathAliases>
						<pathAlias name="totalSpace">parent::node()/cell[(@column=&quot;totalSpace&quot;)]</pathAlias>
					</pathAliases>
					<block>
						<set>
							<var ref="totalSpace"/>
							<dataItem>
								<pathAlias ref="totalSpace"/>
								<property>@value</property>
							</dataItem>
						</set>
						<if>
							<equal>
								<var ref="totalSpace"/>
								<integer>0</integer>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
							<if>
								<gte>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<integer>98</integer>
								</gte>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>critical</severity>
									</update>
								</transaction>
								<if>
									<and>
										<gte>
											<dataItem>
												<property>@value</property>
											</dataItem>
											<integer>90</integer>
										</gte>
										<gte>
											<rate>
												<dataItem>
													<property>@value</property>
												</dataItem>
											</rate>
											<integer>0</integer>
										</gte>
									</and>
									<if>
										<equal>
											<dataItem>
												<property>state/@severity</property>
											</dataItem>
											<severity>warning</severity>
										</equal>
										<transaction>
											<delay unit="samples">12</delay>
											<update>
												<property>state/@severity</property>
												<severity>critical</severity>
											</update>
										</transaction>
										<if>
											<notEqual>
												<dataItem>
													<property>state/@severity</property>
												</dataItem>
												<severity>critical</severity>
											</notEqual>
											<transaction>
												<update>
													<property>state/@severity</property>
													<severity>warning</severity>
												</update>
											</transaction>
										</if>
									</if>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>ok</severity>
										</update>
									</transaction>
								</if>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
