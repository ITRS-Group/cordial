<?xml version="1.0" encoding="ISO-8859-1"?>
<gateway compatibility="1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://schema.itrsgroup.com/GA7.12.2-261105/gateway.xsd">
	<types>
		<typeGroup name="Layer 2 - Application Baseline">
			<type name="Layer 2 - Application Baseline">
				<environment ref="Layer 2 - Application Baseline Defaults"/>
				<var name="SAMPLER_GROUP">
					<string>Programs and Logs</string>
				</var>
				<sampler ref="Logs"/>
				<sampler ref="Processes"/>
				<sampler ref="Services"/>
			</type>
		</typeGroup>
	</types>
	<samplers>
		<samplerGroup name="Layer 2 - Application Baseline">
			<sampler name="Logs">
				<var-group>
					<var ref="SAMPLER_GROUP"/>
				</var-group>
				<plugin>
					<fkm>
						<display>
							<columns>
								<column>status</column>
								<column>permissions</column>
								<column>lastModificationTime</column>
								<column>fileSize</column>
								<column>updateRate</column>
								<column>triggerDetails</column>
								<column>fileOwner</column>
								<column>absolutePath</column>
							</columns>
							<triggerMode>MULTIPLE_GROUPED_TRIGGER</triggerMode>
							<lastTriggerInStatus>
								<data>false</data>
							</lastTriggerInStatus>
						</display>
						<isPCREMode>
							<data>true</data>
						</isPCREMode>
						<defaultFileActiveTime>
							<var ref="LOGS_ACTIVE"/>
						</defaultFileActiveTime>
						<extendedNTEventLogOutput>
							<data>true</data>
						</extendedNTEventLogOutput>
						<persistentData>
							<enabled>
								<data>true</data>
							</enabled>
							<saveLocation>
								<data>fkm</data>
							</saveLocation>
						</persistentData>
					</fkm>
				</plugin>
			</sampler>
			<sampler name="Processes">
				<var-group>
					<var ref="SAMPLER_GROUP"/>
				</var-group>
				<plugin>
					<processes>
						<regexMode>PCRE</regexMode>
					</processes>
				</plugin>
				<activeTimes>
					<activeTime>
						<var ref="PROCESSES_ACTIVE"/>
					</activeTime>
				</activeTimes>
			</sampler>
			<sampler name="Services">
				<plugin>
					<win-services/>
				</plugin>
			</sampler>
		</samplerGroup>
	</samplers>
	<rules>
		<ruleGroup name="Layer 2 - Application Baseline">
			<ruleGroup name="Processes">
				<rule name="processInstances">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(param(&quot;PluginName&quot;)=&quot;PROCESSES&quot;)]/dataview/rows/row[not(contains(@name,&quot;#&quot;))]/cell[(@column=&quot;instanceCount&quot;)]</target>
					</targets>
					<priority>10000</priority>
					<block>
						<set>
							<var ref="rowname"/>
							<target>
								<rowName/>
							</target>
						</set>
						<set>
							<var ref="testRowname"/>
							<format>
								<string>(%s,</string>
								<var ref="rowname"/>
							</format>
						</set>
						<set>
							<var ref="sep"/>
							<string>..</string>
						</set>
						<set>
							<var ref="min"/>
							<integer>0</integer>
						</set>
						<set>
							<var ref="max"/>
							<integer>99999</integer>
						</set>
						<if>
							<notEqual>
								<strpos>
									<var ref="processInstances"/>
									<format>
										<string>(%s,</string>
										<var ref="rowname"/>
									</format>
								</strpos>
								<integer>0</integer>
							</notEqual>
							<block>
								<set>
									<var ref="min"/>
									<multiply>
										<double>1.0</double>
										<stringBefore>
											<stringAfter>
												<var ref="processInstances"/>
												<var ref="testRowname"/>
											</stringAfter>
											<var ref="sep"/>
										</stringBefore>
									</multiply>
								</set>
								<set>
									<var ref="max"/>
									<multiply>
										<double>1.0</double>
										<stringBefore>
											<stringAfter>
												<stringAfter>
													<var ref="processInstances"/>
													<var ref="testRowname"/>
												</stringAfter>
												<var ref="sep"/>
											</stringAfter>
											<string>)</string>
										</stringBefore>
									</multiply>
								</set>
							</block>
						</if>
						<if>
							<equal>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string/>
							</equal>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>undefined</severity>
								</update>
							</transaction>
							<if>
								<or>
									<lt>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<var ref="min"/>
									</lt>
									<gt>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<var ref="max"/>
									</gt>
								</or>
								<transaction>
									<delay>1800</delay>
									<update>
										<property>state/@severity</property>
										<severity>critical</severity>
									</update>
								</transaction>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>ok</severity>
									</update>
								</transaction>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
			<ruleGroup name="Logs">
				<rule name="logStatus">
					<targets>
						<target>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 2 - Application Baseline&quot;)][(param(&quot;PluginName&quot;)=&quot;FKM&quot;)]/dataview/rows/row/cell[(@column=&quot;status&quot;)]</target>
					</targets>
					<priority>10000</priority>
					<block>
						<if>
							<like>
								<dataItem>
									<property>@value</property>
								</dataItem>
								<string>OK</string>
							</like>
							<transaction>
								<update>
									<property>state/@severity</property>
									<severity>ok</severity>
								</update>
							</transaction>
							<if>
								<like>
									<dataItem>
										<property>@value</property>
									</dataItem>
									<string>NOT_FOUND*</string>
								</like>
								<transaction>
									<update>
										<property>state/@severity</property>
										<severity>warning</severity>
									</update>
								</transaction>
								<if>
									<like>
										<dataItem>
											<property>@value</property>
										</dataItem>
										<string/>
									</like>
									<if>
										<like>
											<target>
												<rowName/>
											</target>
											<string>*fail*</string>
										</like>
										<transaction>
											<update>
												<property>state/@severity</property>
												<severity>critical</severity>
											</update>
										</transaction>
										<if>
											<like>
												<target>
													<rowName/>
												</target>
												<string>*warning*</string>
											</like>
											<transaction>
												<update>
													<property>state/@severity</property>
													<severity>warning</severity>
												</update>
											</transaction>
										</if>
									</if>
									<transaction>
										<update>
											<property>state/@severity</property>
											<severity>undefined</severity>
										</update>
									</transaction>
								</if>
							</if>
						</if>
					</block>
				</rule>
			</ruleGroup>
		</ruleGroup>
	</rules>
	<activeTimes>
		<activeTimeGroup name="Layer 2 - Application Baseline">
			<activeTime name="Application - Always">
				<scheduledPeriod>
					<days>
						<monday>true</monday>
						<tuesday>true</tuesday>
						<wednesday>true</wednesday>
						<thursday>true</thursday>
						<friday>true</friday>
						<saturday>true</saturday>
						<sunday>true</sunday>
					</days>
				</scheduledPeriod>
			</activeTime>
		</activeTimeGroup>
	</activeTimes>
	<environments>
		<environmentGroup name="Layer 2 - Application Baseline">
			<environment name="Layer 2 - Application Baseline Defaults">
				<var name="LOGS_ACTIVE">
					<activeTime>
						<activeTime ref="Application - Always"/>
					</activeTime>
				</var>
				<var name="PROCESSES_ACTIVE">
					<activeTime>
						<activeTime ref="Application - Always"/>
					</activeTime>
				</var>
			</environment>
		</environmentGroup>
	</environments>
	<exportedData>
		<dataSet name="Layer 2 - Application Baseline">
			<paths>
				<path>/geneos/gateway/directory/probe/managedEntity/sampler[(@type=&quot;Layer 2 - Application Baseline&quot;)]</path>
			</paths>
		</dataSet>
	</exportedData>
</gateway>