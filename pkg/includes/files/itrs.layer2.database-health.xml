					<plugin>
						<sql-toolkit>
							<queries>
								<query>
									<name>
										<data>System information</data>
									</name>
									<sql>
										<data>SELECT INST_NAME, SERVICE_LEVEL, BLD_LEVEL, FIXPACK_NUM
FROM TABLE(SYSPROC.ENV_GET_INST_INFO()) AS instance_info</data>
									</sql>
								</query>
								<query>
									<name>
										<data>Member and database state</data>
									</name>
									<sql>
										<data>SELECT MEMBER, DB_STATUS, DB_ACTIVATION_STATE, DB_CONN_TIME,
       APPLS_CUR_CONS, APPLS_IN_DB2, NUM_LOCKS_WAITING, LAST_BACKUP
FROM TABLE(MON_GET_DATABASE(-2)) AS database_metrics
ORDER BY MEMBER</data>
									</sql>
								</query>
								<query>
									<name>
										<data>Connection states</data>
									</name>
									<sql>
										<data>SELECT COORD_MEMBER, APPLICATION_STATE, COUNT(*) AS connections
FROM TABLE(MON_GET_CONNECTION(NULL, -2, 0)) AS connection_metrics
GROUP BY COORD_MEMBER, APPLICATION_STATE
ORDER BY COORD_MEMBER, APPLICATION_STATE</data>
									</sql>
								</query>
								<query>
									<name>
										<data>Tablespace capacity</data>
									</name>
									<sql>
										<data>SELECT MEMBER, TBSP_NAME, TBSP_STATE, TBSP_TYPE,
       TBSP_TOTAL_SIZE_KB, TBSP_USED_SIZE_KB, TBSP_USABLE_SIZE_KB
FROM TABLE(MON_GET_TABLESPACE(&apos;&apos;, -2)) AS tablespace_metrics
ORDER BY MEMBER, TBSP_NAME</data>
									</sql>
								</query>
							</queries>
							<connectionVariable>
								<databaseConnection ref="Layer 2 - IBM Db2 Connection"/>
							</connectionVariable>
							<showHeadlines>true</showHeadlines>
							<queryTimeout>
								<data>30</data>
							</queryTimeout>
						</sql-toolkit>
					</plugin>
				</sampler>
				<sampler name="IBM-Db2-Extended">
					<var-group>
						<var ref="SAMPLER_GROUP"/>
					</var-group>
					<sampleInterval>
						<var ref="SLOW_SAMPLE"/>
					</sampleInterval>
					<plugin>
						<sql-toolkit>
							<queries>
								<query>
									<name>
										<data>Transaction log</data>
									</name>
									<sql>
										<data>SELECT MEMBER, TOTAL_LOG_USED_KB, TOTAL_LOG_AVAILABLE_KB
FROM TABLE(MON_GET_TRANSACTION_LOG(-2)) AS transaction_log
ORDER BY MEMBER</data>
									</sql>
								</query>
								<query>
									<name>
										<data>Buffer pools</data>
									</name>
									<sql>
										<data>SELECT MEMBER, BP_NAME, POOL_DATA_P_READS,
       POOL_ASYNC_DATA_READS, POOL_DATA_WRITES
FROM TABLE(MON_GET_BUFFERPOOL(&apos;&apos;, -2)) AS buffer_pool
ORDER BY MEMBER, BP_NAME</data>
									</sql>
								</query>
								<query>
									<name>
										<data>HADR state</data>
									</name>
									<sql>
										<data>SELECT STANDBY_ID, HADR_ROLE, HADR_STATE, HADR_CONNECT_STATUS,
       PRIMARY_MEMBER_HOST, STANDBY_MEMBER_HOST, HADR_SYNCMODE
FROM TABLE(MON_GET_HADR(-2)) AS hadr
ORDER BY STANDBY_ID</data>
									</sql>
								</query>
							</queries>
							<connectionVariable>
								<databaseConnection ref="Layer 2 - IBM Db2 Connection"/>
							</connectionVariable>
							<showHeadlines>true</showHeadlines>
							<queryTimeout>
								<data>60</data>
							</queryTimeout>
						</sql-toolkit>
					</plugin>
				</sampler>
