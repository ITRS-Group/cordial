				<sampler name="MariaDB-Extended">
					<var-group>
						<var ref="SAMPLER_GROUP"/>
					</var-group>
					<sampleInterval>
						<var ref="SLOW_SAMPLE"/>
					</sampleInterval>
					<plugin>
						<sql-toolkit>
							<queries>
								<query>
									<name>
										<data>Replica status</data>
									</name>
									<sql>
										<data>SHOW SLAVE STATUS</data>
									</sql>
								</query>
								<query>
									<name>
										<data>Wait summary</data>
									</name>
									<sql>
										<data>SELECT EVENT_NAME, COUNT_STAR, SUM_TIMER_WAIT
FROM performance_schema.events_waits_summary_global_by_event_name
WHERE COUNT_STAR &gt; 0
ORDER BY SUM_TIMER_WAIT DESC
LIMIT 20</data>
									</sql>
								</query>
							</queries>
							<connectionVariable>
								<databaseConnection ref="Layer 2 - MariaDB Connection"/>
							</connectionVariable>
							<showHeadlines>true</showHeadlines>
							<queryTimeout>
								<data>60</data>
